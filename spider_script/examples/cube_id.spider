Spider(Start)

window("title='Cube Mover' width=500 height=450 bg='#0d1117'")

text("text='CUBE MOVER' x=250 y=20 color='#58a6ff' size=18")
text("text='Use buttons' x=250 y=45 color='gray' size=12")

shape("type='square' x=235 y=185 size=30 color='red' id='cube'")

button("text='UP' x=225 y=280 width=50 height=40 bg='#30363d' color='white' action='move(id=cube y-10)')
button("text='LEFT' x=170 y=330 width=50 height=40 bg='#30363d' color='white' action='move(id=cube x-10)')
button("text='DOWN' x=225 y=330 width=50 height=40 bg='#30363d' color='white' action='move(id=cube y+10)')
button("text='RIGHT' x=280 y=330 width=50 height=40 bg='#30363d' color='white' action='move(id=cube x+10)')

button("text='RESET' x=200 y=390 width=100 height=30 bg='#6e7681' color='white' action='move(id=cube x=235 y=185)')

        
